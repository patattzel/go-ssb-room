set -euo pipefail

args=()
if [[ "${1:-}" == --reset-password ]]; then
  args+=(-reset-password)
  shift
fi
if (( $# > 1 )); then
  echo 'Usage: room-admin [--reset-password] [SSB_ID]' >&2
  exit 1
fi
if (( $# == 1 )); then
  args+=(-- "$1")
else
  args+=(-prompt-id)
fi

umask 077
exec gosu cloudron:cloudron /app/code/insert-user "-repo=${REPO:-/app/data/ssb-go-room}" "${args[@]}"
