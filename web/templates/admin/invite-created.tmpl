{{ define "title" }}{{i18n "AdminInviteCreatedTitle"}}{{ end }}
{{ define "content" }}
<section class="room-flow">
  <h1>{{i18n "AdminInviteCreatedTitle"}}</h1>
  <p>{{i18n "AdminInviteCreatedInstruct"}}</p>
  <div class="room-copy">
    <input type="text" id="invite-url" aria-label="{{i18n "CopyInviteLink"}}" value="{{.FacadeURL}}" readonly>
    <button class="room-action room-action-primary" type="button" hidden data-copy-field="invite-url" aria-describedby="invite-copy-status" data-copied="{{i18n "CopySuccess"}}" data-select="{{i18n "CopyManual"}}">{{i18n "CopyInviteLink"}}</button>
    <output id="invite-copy-status" aria-live="polite"></output>
  </div>
  <a class="underline break-all" id="invite-facade-link" href="{{.FacadeURL}}">{{.FacadeURL}}</a>
  <script src="/assets/copy-field.js" defer></script>
</section>
{{end}}
