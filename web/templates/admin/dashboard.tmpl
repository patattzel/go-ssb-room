{{ define "title" }}{{i18n "AdminDashboardTitle"}}{{ end }}
{{ define "content" }}
<section class="room-dashboard">
  <h1>{{i18n "AdminDashboardTitle"}}</h1>
  {{ template "flashes" . }}

  {{if member_can "invite"}}
  <div class="room-dashboard-intro">
    <p>{{i18n "AdminDashboardInviteHelp"}}</p>
    <form action="{{urlTo "admin:invites:create"}}" method="POST">
      {{ .csrfField }}
      <button class="room-action room-action-primary" type="submit">{{i18n "AdminInvitesCreate"}}</button>
    </form>
  </div>
  {{end}}

  <dl class="room-dashboard-stats">
    <div>
      <dt>{{i18n "AdminDashboardOnline"}}</dt>
      <dd id="online-count">{{if lt .OnlineCount 0}}—{{else}}{{.OnlineCount}}{{end}}</dd>
    </div>
    <div>
      <dt><a class="underline" href="{{urlTo "admin:members:overview"}}">{{i18n "AdminMembersTitle"}}</a></dt>
      <dd id="member-count">{{.MemberCount}}</dd>
    </div>
    <div>
      <dt><a class="underline" href="{{urlTo "admin:invites:overview"}}">{{i18n "AdminInvitesTitle"}}</a></dt>
      <dd id="invite-count">{{.InviteCount}}</dd>
    </div>
    <div>
      <dt><a class="underline" href="{{urlTo "admin:denied-keys:overview"}}">{{i18n "AdminDeniedKeysTitle"}}</a></dt>
      <dd id="denied-count">{{.DeniedCount}}</dd>
    </div>
  </dl>

  {{if lt .OnlineCount 0}}
    <p>{{i18n "AdminDashboardOnlineUnavailable"}}</p>
  {{else if eq .OnlineCount 0}}
    <p>{{i18n "AdminDashboardOffline"}}</p>
  {{else}}
    <ul class="room-dashboard-peers" id="connected-list">
      {{range .OnlineUsers}}
      <li><a {{if gt .ID 0}}class="underline" href="{{urlTo "admin:member:details" "id" .ID}}"{{end}}>{{.String}}</a></li>
      {{end}}
    </ul>
  {{end}}

  <details>
    <summary>{{i18n "AdminDashboardConnection"}}</summary>
    <p class="break-all">{{i18n "AdminDashboardRoomID"}} <code>{{.RoomRef}}</code></p>
    <div class="room-copy">
      <input type="text" id="room-address" aria-label="{{i18n "AdminDashboardRoomAddress"}}" value="{{.RoomAddress}}" readonly>
      <button class="room-action" type="button" hidden data-copy-field="room-address" aria-describedby="room-copy-status" data-copied="{{i18n "CopySuccess"}}" data-select="{{i18n "CopyManual"}}">{{i18n "CopyRoomAddress"}}</button>
      <output id="room-copy-status" aria-live="polite"></output>
    </div>
  </details>
  <script src="/assets/copy-field.js" defer></script>
</section>
{{end}}
