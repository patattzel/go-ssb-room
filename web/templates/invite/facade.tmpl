{{ define "title" }}{{ i18n "InviteFacadeTitle" }}{{ end }}
{{ define "content" }}
<section class="room-flow">
  <h1>{{i18n "InviteFacadeTitle"}}</h1>
  <p id="welcome">{{i18nWithData "InviteFacadeWelcome" "RoomTitle" .RoomTitle}}</p>
  <p>{{i18n "InviteFacadeInstruct"}}</p>
  <a id="claim-invite-uri" class="room-action room-action-primary" href="{{.JoinRoomURI}}" data-href-fallback="{{.FallbackURL}}">{{i18n "InviteFacadeJoin"}}</a>
  <p id="waiting" role="status" hidden>{{i18n "SSBURIOpening"}}</p>

  <details>
    <summary>{{i18n "InviteOtherOptions"}}</summary>
    <p>{{i18n "InvitePasteHelp"}}</p>
    {{template "copy-invite-url" .InviteURL}}
    <p><a class="underline" href="https://www.manyver.se/download/">{{i18n "SSBURIFailureInstallManyverse"}}</a></p>
    <p><a class="underline" href="{{.ManualURL}}">{{i18n "InviteFacadeFallbackInsertID"}}</a></p>
  </details>
  <details>
    <summary>{{i18n "InviteScan"}}</summary>
    <p>{{i18n "InviteFacadeInstructQR"}}</p>
    <img id="start-auth-qrcode" src="{{.QRCodeURI}}" alt="{{i18n "InviteQRCode"}}" width="192" height="192">
  </details>
  <script src="/assets/invite-uri.js" defer></script>
</section>
{{ end }}
