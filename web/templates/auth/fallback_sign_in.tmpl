{{ define "title" }}{{i18n "AuthTitle"}}{{ end }}
{{ define "content" }}
<section class="room-flow">
  <h1>{{i18n "AuthFallbackTitle"}}</h1>
  <p id="welcome">{{i18n "AuthFallbackWelcome"}}</p>
  {{ template "flashes" . }}
  <form id="password-fallback" method="POST" action="{{urlTo "auth:fallback:finalize"}}" class="room-login">
    {{ .csrfField }}
    <label for="room-login-id">{{i18n "AuthSSBID"}}</label>
    <input id="room-login-id" type="text" name="user" autocomplete="username" autocapitalize="off" spellcheck="false" required>
    <label for="room-login-password">{{i18n "AuthPasswordLabel"}}</label>
    <input id="room-login-password" type="password" name="pass" autocomplete="current-password" required>
    <button class="room-action room-action-primary" type="submit">{{i18n "AuthSignIn"}}</button>
  </form>
  <a class="underline" href="{{urlTo "auth:withssb:login"}}">{{i18n "AuthWithSSBTitle"}}</a>
</section>
{{end}}
